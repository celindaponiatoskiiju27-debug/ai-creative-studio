OPENAI_API_KEY=请填写你的密钥
OPENAI_BASE_URL=https://www.packyapi.ai/v1
OPENAI_IMAGE_MODEL=gpt-image-2
# 多模型列表；enabled=false 时前端会自动置灰。JSON 必须保持单行。
IMAGE_MODELS_JSON=[{"id":"qwen-image-2.0","name":"千问图像 2.0","provider":"aliyun","description":"国内默认 · 高性价比文生图与编辑","creditCost":2,"supportsGenerate":true,"supportsEdit":true,"enabled":true},{"id":"qwen-image-edit-plus","name":"千问图片编辑 Plus","provider":"aliyun","description":"国内默认 · 图片修改与多图合成","creditCost":3,"supportsGenerate":false,"supportsEdit":true,"enabled":true},{"id":"gpt-image-2","name":"GPT Image 2","provider":"openai","description":"海外高质量备用图片模型","creditCost":5,"supportsGenerate":true,"supportsEdit":true,"enabled":true}]
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_TEXT_API_KEY=请填写专用于 GPT-5.4 的 API Key
OPENAI_TEXT_BASE_URL=https://www.packyapi.ai/v1
TEXT_MODELS_JSON=[{"id":"qwen-plus","name":"通义千问 Plus","provider":"aliyun","description":"默认：高性价比电商文案与提示词润色","enabled":true},{"id":"gpt-5.4","name":"GPT-5.4","provider":"openai","description":"备用：百炼故障时自动兜底","enabled":true}]
PORT=3001
MOCK_OPENAI=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=请填写服务端 service_role 密钥
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=请填写公开 anon 密钥
FAL_KEY=请填写 fal.ai API Key
VIDEO_PROVIDER=aliyun
VIDEO_MODEL=wan2.6-i2v-flash
VIDEO_TEXT_MODEL=wan2.6-t2v
# 可同时配置阿里云和 fal 模型；缺少对应平台密钥时该项会自动置灰。
VIDEO_MODELS_JSON=[{"id":"wan2.6-i2v-flash","textModel":"wan2.6-t2v","name":"通义万相 2.6","provider":"aliyun","description":"稳定的图生 GIF 与文生视频","enabled":true},{"id":"fal-ai/ltx-video/image-to-video","name":"LTX Video","provider":"fal","description":"fal.ai 图生动态备用模型","enabled":true}]
DASHSCOPE_API_KEY=请填写阿里云百炼 API Key
DASHSCOPE_BASE_URL=https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_COMPATIBLE_BASE_URL=https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
